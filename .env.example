# PrivacyGate AI — example env. Copy to untracked .env and fill via infra/scripts/keygen.py.
# Never commit real secrets. Local Anvil accounts are dev-only.

# --- Secrets (blank here; generate locally, do not commit) ---
SESSION_SIGNING_SECRET=
GATEWAY_DATA_KEY_B64=
SIMULATOR_ED25519_SEED_B64=
SIMULATOR_ED25519_PUB_B64=
OWNER_ADDRESS=
READER_ADDRESS=

# --- Safe non-secret defaults ---
CHAIN_ID=31337
ANVIL_RPC=http://127.0.0.1:8545
GATEWAY_URL=http://127.0.0.1:8000
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TELEMETRY_QOS=1

# --- Ollama AI backend (OpenAI-compatible client, local only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_API_KEY=ollama

# Native v2: optional config override (generated protected secrets live in var/v2).
PG_V2_CONFIG=var/v2/config.json
# Legacy settings above are not used by the v2 runtime.
