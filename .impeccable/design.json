  "narrative": {
    "northStar": "Light control room",
    "overview": "A daylight operations workspace with white surfaces, a pale sage canvas, restrained green actions, purple chain reads, and amber chain writes. Familiar sans-serif text and explicit labels make the network understandable without specialist knowledge.\n\nScope includes the network overview and all nonhome pages: My devices (`/dashboard`), Shared insights (`/insights`), Sign in (`/login`), and the technical reference. A shared light shell puts client tasks first and supplies a persistent Back to network link. This is a visual-design record; `docs/DESIGN.md` remains the authoritative architecture and threat model. The overview describes simulated activity, not measured service health. Sign-in retains the existing wallet authentication; presentation changes do not demonstrate completed backend integration.",
    "keyCharacteristics": [
      "Light surfaces with subtle borders.",
      "Plain client task names and a persistent way back to the network.",
      "A selectable network map with a plain-language inspector.",
      "Explicit data, chain-read, and chain-write labels.",
      "A guided walkthrough with an activity feed and simple panels."
    ],
    "rules": [
      {
        "name": "The Connection Label Rule",
        "body": "Pair connection colors with written roles and directional arrows; color alone must not explain the network.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** keep simulation status visible beside the overview heading and activity.",
      "**Do** describe sends, receives, and blockchain connection in the inspector.",
      "**Do** preserve visible keyboard focus and selected state.",
      "**Do** retain client task labels and a visible Back to network link on nonhome pages.",
      "**Do** use explicit connection descriptions in the compact node list."
    ],
    "donts": [
      "**Don't** present simulated activity as measured connectivity or confirmed real transactions.",
      "**Don't** imply that the compact list is a linear data pipeline.",
      "**Don't** put raw telemetry, private keys, or plaintext insight content in overview examples."
    ]
  }
}
