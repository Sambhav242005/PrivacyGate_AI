{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacygate.ai/schemas/policy-manifest-v1.json",
  "$title": "PolicyManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_id", "recipient_wallet_lowercase", "scope", "allowed_event_types", "allowed_fields", "expires_at_unix", "policy_revision"],
  "properties": {
    "resource_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "recipient_wallet_lowercase": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "scope": { "const": "READ_INSIGHT" },
    "allowed_event_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "MACHINE_ANOMALY" }
    },
    "allowed_fields": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": ["event_id", "event_type", "severity", "observed_at", "model_version"]
      }
    },
    "expires_at_unix": { "type": "integer", "exclusiveMinimum": 0 },
    "policy_revision": { "type": "integer", "exclusiveMinimum": 0 }
  }
}
