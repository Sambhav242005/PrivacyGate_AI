{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privacygate.ai/schemas/signed-telemetry-v1.json",
  "title": "SignedTelemetryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "resource_id", "sequence", "issued_at", "telemetry", "signature_b64"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "sequence": { "type": "integer", "exclusiveMinimum": 0 },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "telemetry": { "$ref": "telemetry-v1.json" },
    "signature_b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "description": "RFC4648 standard base64 of exactly 64 Ed25519 signature bytes"
    }
  }
}
